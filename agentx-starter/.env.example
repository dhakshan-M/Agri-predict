# AgentX Starter Environment Variables
# Provide either GEMINI_API_KEY or GROQ_API_KEY (optional for offline testing)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
DEFAULT_MODEL=gemini-2.0-flash
FALLBACK_MODEL=llama-3.3-70b-versatile

# ReAct Safety Caps
MAX_ITERATIONS=10
MAX_REPEATS=2
TIMEOUT_SECONDS=30
